{
  "name": "automationpratice-pw",
  "version": "1.0.0",
  "description": "Automação E2E passo a passo do site Automation Practice com Playwright e TypeScript",
  "scripts": {
    "test": "playwright test tests/e2e --project=chromium",
    "test:smoke": "playwright test tests/e2e --project=chromium --grep @smoke",
    "test:regression": "playwright test tests/e2e --project=chromium --grep @regression",
    "test:negative": "playwright test tests/e2e --project=chromium --grep @negative",
    "test:mobile": "playwright test tests/e2e --project=mobile-chrome --grep @smoke",
    "test:cross-browser": "playwright test tests/e2e --project=chromium --project=firefox --project=webkit",
    "test:a11y": "playwright test tests/a11y --project=chromium",
    "test:headed": "playwright test tests/e2e --project=chromium --headed",
    "test:ui": "playwright test tests/e2e --project=chromium --ui",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.0.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.2.1",
    "eslint-plugin-playwright": "^2.10.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.58.2"
  }
}
